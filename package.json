{
  "name": "linkshort",
  "version": "0.1.0",
  "description": "URL shortener / link analytics platform",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/amqplib": "^0.10.8",
    "amqplib": "^2.0.1",
    "express": "^4.19.2",
    "nanoid": "^3.3.7",
    "pg": "^8.12.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
